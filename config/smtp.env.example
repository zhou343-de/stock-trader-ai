# SMTP Configuration Example
# Copy this file to smtp.env and fill in your credentials
#
# For 163 Mail: Use authorization code (not login password)
# For QQ Mail: Use authorization code from mail settings
# For Gmail: Enable "Less secure app access" or use App Password

SMTP_USER=your_email@163.com
SMTP_PASS=your_smtp_authorization_code
FROM_EMAIL=your_email@163.com
TO_EMAIL=recipient1@example.com,recipient2@example.com
